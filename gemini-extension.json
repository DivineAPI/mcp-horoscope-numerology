{
  "name": "divineapi-horoscope-numerology",
  "version": "1.0.0",
  "description": "Horoscopes in 25 languages, tarot readings and numerology numbers in Gemini CLI, from DivineAPI's hosted server.",
  "mcpServers": {
    "divineapi-horoscope": {
      "httpUrl": "https://mcp.divineapi.com/horoscope/mcp",
      "headers": {
        "X-Divine-Api-Key": "${DIVINE_API_KEY}",
        "X-Divine-Auth-Token": "${DIVINE_AUTH_TOKEN}"
      },
      "timeout": 60000
    }
  },
  "settings": [
    {
      "name": "DivineAPI API key",
      "description": "From your DivineAPI dashboard (https://divineapi.com).",
      "envVar": "DIVINE_API_KEY",
      "sensitive": true
    },
    {
      "name": "DivineAPI auth token",
      "description": "From your DivineAPI dashboard.",
      "envVar": "DIVINE_AUTH_TOKEN",
      "sensitive": true
    }
  ]
}
